# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg

# uv
.uv/

# Weights, caches, and other large artifacts - never commit
models/
cache/
checkpoints/
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.npz
*.h5

# Calibration/evaluation corpora stay local
data/calibration/*
!data/calibration/.gitkeep
data/evaluation/*
!data/evaluation/.gitkeep

# Generated runtime state and machine-specific reports
artifacts/logs/
artifacts/plots/
artifacts/*.json
artifacts/*.jsonl
artifacts/*.txt
artifacts/progress.json
artifacts/reports/*
!artifacts/reports/.gitkeep
!artifacts/reports/01_model_inventory.md

# Third-party checkouts are pinned by versions.json only
third_party/*
!third_party/.gitkeep
!third_party/versions.json

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Local secrets
.hf_token
HF_TOKEN
*.pem
